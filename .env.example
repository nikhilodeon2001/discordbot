# Copy this file to .env and fill in values for local development.
# For staging: use the staging Discord bot token + staging MongoDB URI.
# For prod: values are set via Heroku config vars, not this file.

# Discord
discord_token=
DISCORD_MINI_GAME_AUDIO_BOT_TOKEN=

# MongoDB
mongo_db_string=

# OpenAI
openai_api_key=

# Sentry
SENTRY_DSN=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2

# User-Agent email for Wikipedia/Reddit API calls
USER_AGENT_EMAIL=

# Third-party APIs
openweather_api_key=
googlemaps_api_key=
googletranslate_api_key=
webster_api_key=
webster_thes_api_key=
currency_api_key=
deepgram_api_key=

# Meta social publishing
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_SHORT_LIVED_USER_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v23.0
DISCORD_INVITE_URL=
MUSEUM_BACKFILL_ENABLED=false
MUSEUM_BACKFILL_DAILY_BATCH_SIZE=3
MUSEUM_BACKFILL_TIMEZONE=America/Los_Angeles
MUSEUM_BACKFILL_POST_TIMES=09:00,14:00,19:00

# Discord server config
# stage or prod — controls which server/channel IDs are used
ENVIRONMENT=stage
channel_id=

# Set to true locally to allow solo testing of multiplayer mini-games (okrasays, etc.)
# Leave unset on Heroku (defaults to false)
ALLOW_SOLO_TESTING=true
